# Copy to .env.local for local runs; on Vercel set these in
# Project → Settings → Environment Variables. Never commit real values.

# PostgreSQL. Any server: Neon, Supabase, Vercel Postgres or your own.
# Without it leads are kept in memory only and vanish on restart.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Only if your server uses a self-signed certificate.
# PGSSL_NO_VERIFY=1

# Password for /admin. Choose a long one.
ADMIN_PASSWORD=

# Signs the admin session cookie and salts the stored IP hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Bitrix24 inbound webhook. THIS IS A CREDENTIAL — anyone holding it can read
# and write your CRM. Keep it here only, never in the code.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.kz/rest/<user>/<token>/

# Optional: numeric id of the employee leads are assigned to.
# BITRIX_ASSIGNED_BY_ID=
